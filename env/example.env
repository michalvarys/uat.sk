# Šablona konfigurace prostředí.
#
# Zkopírujte podle prostředí a doplňte hodnoty:
#   cp env/example.env env/production.env
#   cp env/example.env env/staging.env
#
# Soubory *.env se do gitu NEUKLÁDAJÍ (viz .gitignore) — obsahují hesla
# a klíče. Na server je dostanete přes scripts/sync-env.sh.

# Které prostředí tento soubor popisuje: production | staging | dev
ENVIRONMENT=staging

# --- domény -----------------------------------------------------------------
# Musí mít A záznam mířící na tento server, jinak Let's Encrypt
# nevydá certifikát.
FE_DOMAIN=staging.uat.sk
BE_DOMAIN=staging-cms.uat.sk
EMAIL=admin@uat.sk

# --- kde leží data ----------------------------------------------------------
# Databáze a uploady. Každé prostředí musí mít vlastní složku, jinak by
# si prostředí přepisovala data navzájem.
DATA_DIR=/srv/uat/staging

# --- porty na localhost -----------------------------------------------------
# Na tyto porty se v aaPanelu nasměruje reverse proxy. Každé prostředí
# musí mít jiné, jinak je nepůjde spustit vedle sebe.
#   produkce: 3000 / 1337
#   staging:  3001 / 1338
#   dev:      3002 / 1339
FE_PORT=3001
BE_PORT=1338

# --- databáze ---------------------------------------------------------------
POSTGRESQL_DB=uat_cms
POSTGRESQL_USER=uat_user
POSTGRESQL_PASS=
# Port ven má jen staging a dev, produkce databázi nevystavuje.
POSTGRESQL_PORT=5434

# --- Strapi -----------------------------------------------------------------
# Vygenerujte: openssl rand -base64 32
# Na každém prostředí JINÉ hodnoty.
APP_KEYS=
JWT_SECRET=
ADMIN_JWT_SECRET=
API_TOKEN_SALT=
TRANSFER_TOKEN_SALT=

# API token pro frontend. Vytvoří se v administraci Strapi
# (Settings → API Tokens) až po prvním startu.
API_TOKEN=

GEMINI_API_KEY=

# --- image ------------------------------------------------------------------
# Tag určuje, co poběží. Produkce má konkrétní verzi, ne latest —
# aby se nasazení nedělo samo při restartu.
FRONTEND_IMAGE=ghcr.io/michalvarys/uat-frontend
BACKEND_IMAGE=ghcr.io/michalvarys/uat-admin

# Obě aplikace berou konfiguraci z proměnných prostředí až za běhu,
# takže tentýž image běží na stagingu i na produkci. Adresy CMS a domény
# se odvozují z FE_DOMAIN a BE_DOMAIN výš.
FRONTEND_TAG=2.0.1
BACKEND_TAG=2.0.0

# Ochranu stagingu heslem a hlavičku noindex nastavuje nginx v aaPanelu,
# ne tento soubor — viz docs/NGINX.md.
